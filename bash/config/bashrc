
source-dir () {
    for dir; do
        for file in $dir/* ; do
            [ -r "$file" ] && source "$file"
        done
    done
}

source-subdir () {
    source-dir ~/.config/bash/$1 ~/.config/bash-local/$1
}

source-subdir rc.d

if [ -t 0 ] ; then
	source-subdir interactive.d
	cd ~
fi

